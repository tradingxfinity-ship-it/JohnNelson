# Where inquiry emails are delivered (defaults to getitsoldsa@gmail.com)
INQUIRY_TO_EMAIL=getitsoldsa@gmail.com

# SMTP account used to send inquiry emails (Gmail example; see README)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=getitsoldsa@gmail.com
SMTP_PASS=your-16-character-app-password

# Optional: "From" address. Must be an address the SMTP account may send as. Defaults to SMTP_USER.
# INQUIRY_FROM_EMAIL=

# Public site URL, used for canonical links and social previews
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Local development only: print inquiry emails to the terminal instead of sending them
# EMAIL_TRANSPORT=log

# LERA MLS listing feed (RESO Web API). Leave unset until John's broker has signed
# LERA's data agreement; until then Search homes shows the team's own listings.
# LERA_RESO_URL=https://<feed host>/<path>   (the OData base URL LERA or the feed provider gives you)
# LERA_RESO_TOKEN=
# The team's MLS office ID, used to mark and filter "Our listings"
# LERA_OFFICE_MLS_ID=
